NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_ORIGIN=https://www.harloai.co
NEXT_PUBLIC_EMAIL_ASSET_URL=https://harloai.co
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional. Set only in local/preview testing so CAPI events appear in Meta Events Manager > Test events.
META_TEST_EVENT_CODE=
HARLO_INTERNAL_ADMIN_EMAILS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional. Defaults are set in lib/ai/openai.ts.
OPENAI_ANSWER_MODEL=
OPENAI_CLASSIFY_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_PLANNER_MODEL=

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_STARTER=
STRIPE_PRODUCT_GROWTH=
STRIPE_PRODUCT_PRO=

# Optional. If provided, checkout uses these directly instead of resolving prices from products.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Optional. Recurring add-ons can resolve prices from these product IDs, or use explicit price IDs below.
STRIPE_PRODUCT_ADDON_AUTO_RECHARGE_CREDITS=
STRIPE_PRODUCT_ADDON_EXTRA_AGENT=
STRIPE_PRODUCT_ADDON_EXTRA_SEAT=
STRIPE_PRODUCT_ADDON_REMOVE_BRANDING=
STRIPE_PRICE_ADDON_AUTO_RECHARGE_CREDITS=
STRIPE_PRICE_ADDON_EXTRA_AGENT=
STRIPE_PRICE_ADDON_EXTRA_SEAT=
STRIPE_PRICE_ADDON_REMOVE_BRANDING=
# Optional. Sends billing limit alerts to organization owners/admins.
RESEND_API_KEY=
BILLING_ALERT_FROM_EMAIL=
TEAM_INVITE_FROM_EMAIL=
CRON_SECRET=replace-with-a-long-random-secret

# Integration OAuth clients. Callback URL pattern:
# ${NEXT_PUBLIC_APP_URL}/api/integrations/{provider}/callback
INTEGRATION_ENCRYPTION_KEY=
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=
CALENDLY_REQUESTED_SCOPES=users:read event_types:read webhooks:write webhooks:read
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=
CALCOM_REDIRECT_URI=
CALCOM_REQUESTED_SCOPES=PROFILE_READ EVENT_TYPE_READ
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=
JOBBER_REQUESTED_SCOPES=clients:read clients:write requests:read requests:write
# Optional. Defaults to 2025-04-16 in code if omitted.
JOBBER_GRAPHQL_VERSION=2025-04-16
# Configure this URL for the APP_DISCONNECT topic in Jobber Developer Center:
# https://www.harloai.co/api/integrations/jobber/webhook
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_REQUESTED_SCOPES=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
HUBSPOT_REQUESTED_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
MAILCHIMP_REDIRECT_URI=
MAILCHIMP_REQUESTED_SCOPES=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_DEFAULT_AUDIENCE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SHEETS_REQUESTED_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/userinfo.email
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=
